    <script>
        // Initialize TypeIt for animated typing effect
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof TypeIt !== 'undefined' && document.getElementById('indexHeader')) {
                new TypeIt('#indexHeader', {
                    strings: ['Code is Art'],
                    speed: 100,
                    waitUntilVisible: true
                }).go();
            }
        });
    </script> 